
APP_NAME=chinook-mcp-server
APP_VERSION=0.1.0
APP_ENV=development

DATABASE_PATH=data/chinook.db
SQLALCHEMY_ECHO=false

LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=logs/chinook-mcp-server.log


# Transport: stdio locally; streamable-http on Render
MCP_TRANSPORT=streamable-http

# HTTP configuration
MCP_PATH=/mcp
MCP_PORT=8000


# Set these in Render, not in source control.
MCP_API_KEY=
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

MCP_SERVER_URL=https://chinook-mcp-server.onrender.com/mcp
